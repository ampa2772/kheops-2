# =============================================================================
# Kheops 2 — Configuration unifiée (Electron + Serveur + Client)
# -----------------------------------------------------------------------------
# MODÈLE. Copiez ce fichier en « .env » à la racine et remplacez chaque
# ICI_METTRE_... par votre propre valeur. Le vrai .env n'est JAMAIS versionné.
# =============================================================================

# Mode
NODE_ENV=development
ELECTRON_MODE=true

# Serveur Express
PORT=5000
FRONTEND_URL=http://localhost:3000
ELECTRON_START_URL=http://localhost:3000

# Moteur bureautique open source (Collabora Online, optionnel). Lorsqu'il est
# absent, l'Éditeur Kheops classique reste utilisé automatiquement.
# KHEOPS_FEATURE_OFFICE_ENGINE=true
# OFFICE_ENGINE_PUBLIC_URL=https://office.example.fr
# OFFICE_ENGINE_INTERNAL_URL=https://office.example.fr
# WOPI_PUBLIC_BASE_URL=https://app.example.fr

# MongoDB Atlas — chaîne de connexion complète (utilisateur:motdepasse@cluster)
MONGODB_URI=ICI_METTRE_LA_CHAINE_DE_CONNEXION_MONGODB_ATLAS

# JWT — clé de signature des sessions
# Générer via : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=ICI_METTRE_LA_CLE_SECRETE_JWT

# Chiffrement au repos des refresh tokens OAuth (Google/Microsoft) — AES-256-GCM
# Générer via : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Doit être identique entre .env racine et server/.env.
TOKEN_ENCRYPTION_KEY=ICI_METTRE_LA_CLE_DE_CHIFFREMENT_DES_TOKENS

# Google OAuth & Gmail (console Google Cloud → Identifiants OAuth)
GOOGLE_CLIENT_ID=ICI_METTRE_LE_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=ICI_METTRE_LE_GOOGLE_CLIENT_SECRET
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Microsoft OAuth — Login utilisateur (Public Client + PKCE, multi-tenant)
MICROSOFT_CLIENT_ID=ICI_METTRE_LE_MICROSOFT_CLIENT_ID
MICROSOFT_AUTHORITY=https://login.microsoftonline.com/common
MICROSOFT_CALLBACK_URL=http://localhost:5000/api/auth/microsoft/callback

# Gmail SMTP — Envoi des mails serveur (reset password, notifications)
# App Password 16 caractères : Google Account → Sécurité → Validation en 2 étapes → Mots de passe d'application
GMAIL_USER=ICI_METTRE_L_ADRESSE_GMAIL_EXPEDITRICE
GMAIL_APP_PASSWORD=ICI_METTRE_LE_MOT_DE_PASSE_D_APPLICATION_GMAIL

# Messagerie OAuth durable — voir aussi server/.env.example.
# MAIL_WORKER_ENABLED=true
# MAIL_WEBHOOK_SECRET=ICI_METTRE_UN_SECRET_WEBHOOK_AU_MOINS_32_CARACTERES
# GMAIL_PUBSUB_TOPIC=projects/kheops-2/topics/kheops-mail
# GMAIL_PUBSUB_AUDIENCE=https://votre-service/api/mail-sync/webhooks/google
# MICROSOFT_MAIL_NOTIFICATION_URL=https://votre-service/api/mail-sync/webhooks/microsoft
# MICROSOFT_MAIL_LIFECYCLE_URL=https://votre-service/api/mail-sync/webhooks/microsoft
