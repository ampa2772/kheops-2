{
  "name": "kheops2-companion",
  "productName": "Kheops 2 Companion",
  "version": "1.0.6",
  "description": "Agent local mince et invisible : ouvre/edite les .docx Kheops dans Microsoft Word, synchronise vers le backend. Aucun secret, aucune connexion MongoDB.",
  "private": true,
  "main": "main.js",
  "author": "Kheops 2",
  "scripts": {
    "test": "node --test --test-concurrency=1 test",
    "start": "electron .",
    "dist": "electron-builder --config electron-builder.companion.json --projectDir .."
  },
  "dependencies": {
    "axios": "^1.7.7",
    "chokidar": "^3.6.0",
    "form-data": "^4.0.1"
  },
  "devDependencies": {
    "electron": "^31.7.6",
    "electron-builder": "^24.13.3"
  }
}
