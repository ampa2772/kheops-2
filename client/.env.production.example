# Kheops 2 — client/.env.production (MODÈLE)
# Copiez en « client/.env.production ». Ces valeurs sont des URLs locales,
# pas des secrets ; adaptez-les si votre backend tourne ailleurs.

REACT_APP_API_URL=http://localhost:5000
REACT_APP_WEBSOCKET_URL=http://localhost:8080

GENERATE_SOURCEMAP=false

# Build prod : bypass auth désactivé (login OAuth Google/Microsoft requis).
REACT_APP_KHEOPS_BYPASS_AUTH=false
