# Kheops 2 — client/.env.development (MODÈLE)
# Copiez en « client/.env.development ». Valeurs locales, pas des secrets.

REACT_APP_API_URL=http://localhost:5000
REACT_APP_WEBSOCKET_URL=http://localhost:8080

GENERATE_SOURCEMAP=false

# Mode dev : bypass auth actif. Doit rester aligné avec KHEOPS_BYPASS_AUTH du server/.env.
REACT_APP_KHEOPS_BYPASS_AUTH=true
