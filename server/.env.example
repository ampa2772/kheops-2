# =============================================================================
# Kheops 2 — server/.env (MODÈLE)
# Copiez en « server/.env » et remplacez chaque ICI_METTRE_... par sa valeur.
# Plusieurs clés DOIVENT être identiques à celles du .env racine (voir notes).
# =============================================================================

# MongoDB Atlas — chaîne de connexion complète
MONGODB_URI=ICI_METTRE_LA_CHAINE_DE_CONNEXION_MONGODB_ATLAS
FRONTEND_URL=http://localhost:3000
PORT=5000

# Mode dev : bypass auth actif (un utilisateur de test est auto-connecté).
# Mettre 'false' (ou supprimer) pour exiger le login OAuth.
# La build packagée force automatiquement 'false' via main.js.
KHEOPS_BYPASS_AUTH=true

# JWT — DOIT être identique au JWT_SECRET du .env racine
JWT_SECRET=ICI_METTRE_LA_CLE_SECRETE_JWT

# Chiffrement refresh tokens OAuth — DOIT être identique au .env racine
TOKEN_ENCRYPTION_KEY=ICI_METTRE_LA_CLE_DE_CHIFFREMENT_DES_TOKENS

# Google OAuth & Gmail
GOOGLE_CLIENT_ID=ICI_METTRE_LE_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=ICI_METTRE_LE_GOOGLE_CLIENT_SECRET
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Gmail SMTP — Envoi des mails serveur (reset password, notifications)
GMAIL_USER=ICI_METTRE_L_ADRESSE_GMAIL_EXPEDITRICE
GMAIL_APP_PASSWORD=ICI_METTRE_LE_MOT_DE_PASSE_D_APPLICATION_GMAIL
