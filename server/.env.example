# =============================================================================
# Kheops 2 — server/.env (MODÈLE)
# Copiez en « server/.env » et remplacez chaque ICI_METTRE_... par sa valeur.
# Plusieurs clés DOIVENT être identiques à celles du .env racine (voir notes).
#
# TROIS FICHIERS, TROIS RÔLES (chargeur central server/config/env.js) :
#   - server/.env             : fichier de DÉPLOIEMENT. Lu par scripts/gcp/deploy.sh
#                               pour comparer/épingler les secrets Secret Manager.
#                               Il désigne la base de préproduction et n'est JAMAIS
#                               chargé par un serveur ou un script local, sauf
#                               dérogation KHEOPS_DB_OVERRIDE=preprod +
#                               KHEOPS_DB_OVERRIDE_REASON="motif" (scripts :
#                               --target=preprod --confirm-preprod en plus).
#   - server/.env.development : poste de développement, OBLIGATOIRE en local,
#                               base nommée kheops2_dev (modèle .env.development.example).
#   - server/.env.test        : NODE_ENV=test, base kheops2_test, facultatif
#                               (les tests Jest ne lisent aucun fichier ;
#                               modèle .env.test.example).
# En hébergement (KHEOPS_HOSTED=true / NODE_ENV=production), aucun fichier
# n'est lu : les variables sont injectées par Cloud Run ou par Electron.
# Les commutateurs de garde (KHEOPS_HOSTED, NODE_ENV, KHEOPS_ENV_FILE,
# KHEOPS_DB_OVERRIDE, KHEOPS_DB_OVERRIDE_REASON, JEST_WORKER_ID) ne sont lus
# que dans l'environnement du processus : écrits dans ce fichier, ils sont
# ignorés avec un avertissement [Config].
# =============================================================================

# MongoDB Atlas — chaîne de connexion complète
MONGODB_URI=ICI_METTRE_LA_CHAINE_DE_CONNEXION_MONGODB_ATLAS
FRONTEND_URL=http://localhost:3000
PORT=5000

# Moteur bureautique open source / WOPI. Laisser commenté pour utiliser
# uniquement l'éditeur historique.
# KHEOPS_FEATURE_OFFICE_ENGINE=true
# OFFICE_ENGINE_PUBLIC_URL=https://office.example.fr
# OFFICE_ENGINE_INTERNAL_URL=https://office.example.fr
# WOPI_PUBLIC_BASE_URL=https://app.example.fr
# OFFICE_ENGINE_TOKEN_TTL_SECONDS=3600

# Mode dev : bypass auth actif (un utilisateur de test est auto-connecté).
# Mettre 'false' (ou supprimer) pour exiger le login OAuth.
# La build packagée force automatiquement 'false' via main.js.
KHEOPS_BYPASS_AUTH=true

# JWT — DOIT être identique au JWT_SECRET du .env racine
JWT_SECRET=ICI_METTRE_LA_CLE_SECRETE_JWT

# Chiffrement refresh tokens OAuth — DOIT être identique au .env racine
TOKEN_ENCRYPTION_KEY=ICI_METTRE_LA_CLE_DE_CHIFFREMENT_DES_TOKENS

# Google OAuth & Gmail
GOOGLE_CLIENT_ID=ICI_METTRE_LE_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=ICI_METTRE_LE_GOOGLE_CLIENT_SECRET
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Gmail SMTP — Envoi des mails serveur (reset password, notifications)
GMAIL_USER=ICI_METTRE_L_ADRESSE_GMAIL_EXPEDITRICE
GMAIL_APP_PASSWORD=ICI_METTRE_LE_MOT_DE_PASSE_D_APPLICATION_GMAIL

# =============================================================================
# HÉBERGEMENT WEB (Phase 3) — à NE définir que pour un serveur exposé sur
# Internet. En usage Electron/local, laissez tout ceci commenté/absent : le
# comportement par défaut (loopback 127.0.0.1, CORS local, pas de rate-limit
# réel) reste inchangé.
# =============================================================================

# Active les garde-fous "déploiement hébergé" (refuse de démarrer si JWT_SECRET
# faible ou si KHEOPS_BYPASS_AUTH=true). NE PAS définir pour l'app Electron.
# KHEOPS_HOSTED=true

# Interface d'écoute. Par défaut 127.0.0.1 (loopback, Electron). Pour héberger,
# écouter sur toutes les interfaces (le reverse proxy/hébergeur gère le TLS) :
# SERVER_BIND_HOST=0.0.0.0

# Origines navigateur autorisées (CORS + Socket.io). FRONTEND_URL en accepte une ;
# CORS_ORIGINS en accepte plusieurs séparées par des virgules.
# CORS_ORIGINS=https://app.kheops-2.fr,https://kheops-2.fr

# Derrière un reverse proxy (Cloud Run, nginx...), nombre de proxies de confiance
# pour dériver req.ip de X-Forwarded-For (nécessaire au rate-limit). Ex : 1.
# TRUST_PROXY=1

# Rate limiting (valeurs par défaut : 1000 req / 15 min / IP ; loopback exempté).
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=1000
# RATE_LIMIT_DISABLED=false

# --- Stockage des fichiers (Phase 4) ---------------------------------------
# Par défaut : disque local (comportement Electron inchangé). Pour héberger,
# basculer sur Google Cloud Storage en définissant GCS_BUCKET.
#
# Racine du stockage local (si on reste en local). Optionnel.
# FILE_STORAGE_LOCAL_ROOT=/var/lib/kheops2/files
#
# Active GCS dès qu'il est défini (bucket dédié, région europe-west1) :
# GCS_BUCKET=kheops-2-files
# GCS_PROJECT_ID=kheops-2-app
# Chemin du fichier de clé du service account (ou utiliser
# GOOGLE_APPLICATION_CREDENTIALS, standard Google). NE PAS committer ce fichier.
# GCS_KEY_FILE=/secrets/kheops-2-gcs-sa.json
# Durée de validité des URLs signées (secondes, défaut 3600).
# GCS_SIGNED_URL_TTL_SEC=3600

# --- Connexion Microsoft (Outlook / agenda / contacts / OneDrive) ---
# ⚠️ Ces 3 clés doivent figurer dans le fichier réellement chargé par le
# serveur (server/.env en déploiement, server/.env.development en local) — pas
# seulement dans le .env racine — sinon le login Microsoft échoue avec
# error=microsoft_config_missing.
# CLIENT_ID = identifiant public de l'app Azure (App Registration).
# Aucun CLIENT_SECRET nécessaire (flux PKCE public).
MICROSOFT_CLIENT_ID=votre-app-azure-client-id
MICROSOFT_AUTHORITY=https://login.microsoftonline.com/common
MICROSOFT_CALLBACK_URL=http://localhost:5000/api/auth/microsoft/callback

# --- Messagerie OAuth durable (cahier complémentaire n°4) -----------------
# Worker Mongo reprenable : requis en hébergement pour traiter en arrière-plan
# les notifications, rattrapages et reprises d'outbox. En local, les envois
# interactifs restent exécutés par la requête et le worker peut rester désactivé.
# MAIL_WORKER_ENABLED=true
# MAIL_WORKER_CONCURRENCY=2
# MAIL_WORKER_POLL_MS=5000

# Secret HMAC distinct des jetons OAuth, >= 32 caractères. Ne jamais l'exposer
# au client ni le committer.
# MAIL_WEBHOOK_SECRET=ICI_METTRE_UN_SECRET_WEBHOOK_AU_MOINS_32_CARACTERES

# Gmail push (Pub/Sub). Le topic doit autoriser gmail-api-push@system.gserviceaccount.com.
# GMAIL_PUBSUB_TOPIC=projects/kheops-2/topics/kheops-mail
# GMAIL_PUBSUB_AUDIENCE=https://votre-service/api/mail-sync/webhooks/google
# Repli privé facultatif pour les tests contrôlés, >= 32 caractères.
# GMAIL_WEBHOOK_TOKEN=ICI_METTRE_UN_SECRET_DE_TEST_AU_MOINS_32_CARACTERES

# Microsoft Graph change notifications. Ces URL publiques doivent pointer vers
# le service Kheops et être en HTTPS en production.
# MICROSOFT_MAIL_NOTIFICATION_URL=https://votre-service/api/mail-sync/webhooks/microsoft
# MICROSOFT_MAIL_LIFECYCLE_URL=https://votre-service/api/mail-sync/webhooks/microsoft
# MICROSOFT_MAIL_SUBSCRIPTION_RESOURCE=/me/messages
