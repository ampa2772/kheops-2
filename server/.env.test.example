# =============================================================================
# Kheops 2 — server/.env.test (MODELE)
# Copiez en « server/.env.test » uniquement si un processus NODE_ENV=test doit
# atteindre une base reelle (scripts --target=test, recette locale
# NODE_ENV=test node index.js). Les tests Jest n'en ont PAS besoin et ne le
# lisent JAMAIS (suites hermetiques, modeles Mongoose simules) : seul
# KHEOPS_ENV_FILE force un fichier sous Jest.
#
# Le nom de base DOIT etre kheops2_test ou contenir « _test » : « test » seul
# (base par defaut du driver, celle qu'ouvre une URI sans base nommee), une base
# absente et les noms reserves (admin, local, config) sont refuses. L'URI ne
# doit jamais viser la base de server/.env (fichier de deploiement) : meme URI,
# ou meme cluster avec la meme base effective (par exemple l'URI de deploiement
# completee par /test), la garde refuse. La derogation KHEOPS_DB_OVERRIDE=preprod
# est interdite en mode test ; les commutateurs de garde (KHEOPS_HOSTED,
# NODE_ENV, KHEOPS_ENV_FILE, KHEOPS_DB_OVERRIDE*) ecrits ici sont ignores.
# =============================================================================

# MongoDB — base de TEST nommee explicitement (kheops2_test).
# Local  : mongodb://127.0.0.1:27017/kheops2_test
# Atlas  : mongodb+srv://UTILISATEUR:MOT_DE_PASSE@CLUSTER.mongodb.net/kheops2_test?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/kheops2_test

FRONTEND_URL=http://localhost:3000
PORT=5000

# Recette en mode strict : connexion reelle exigee.
KHEOPS_BYPASS_AUTH=false

# Secrets PROPRES a l'environnement de test (jamais ceux de server/.env).
JWT_SECRET=ICI_METTRE_UNE_CLE_JWT_DE_TEST
TOKEN_ENCRYPTION_KEY=ICI_METTRE_UNE_CLE_DE_CHIFFREMENT_DE_TEST
