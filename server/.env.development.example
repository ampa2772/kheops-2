# =============================================================================
# Kheops 2 — server/.env.development (MODELE)
# Copiez en « server/.env.development » : c'est le SEUL fichier charge par un
# serveur ou un script lance en local sans NODE_ENV (developpement).
#
# Trois fichiers, trois roles (voir README.md, section Configuration) :
#   - server/.env             : DEPLOIEMENT (secrets epingles par scripts/gcp/deploy.sh,
#                               base de preproduction). JAMAIS charge en local.
#   - server/.env.development : poste de developpement, base kheops2_dev (ce fichier).
#   - server/.env.test        : NODE_ENV=test, base kheops2_test (facultatif pour Jest).
#
# Regle de garde : si MONGODB_URI ci-dessous vise la meme base que server/.env
# (ou que le .env racine) — meme URI, ou meme cluster et meme base effective —
# le serveur refuse de demarrer. Derogation ponctuelle, dans l'environnement du
# processus uniquement : KHEOPS_DB_OVERRIDE=preprod KHEOPS_DB_OVERRIDE_REASON="motif"
# (server/.env est alors charge a la place de ce fichier). Le nom de base DOIT
# etre kheops2_dev ou contenir « _dev » ; une base absente et les noms reserves
# (test, admin, local, config) sont refuses.
# Une variable deja presente dans l'environnement n'est jamais ecrasee. Les
# commutateurs de garde (KHEOPS_HOSTED, NODE_ENV, KHEOPS_ENV_FILE,
# KHEOPS_DB_OVERRIDE, KHEOPS_DB_OVERRIDE_REASON) ecrits ici sont ignores.
# =============================================================================

# MongoDB — base de DEVELOPPEMENT nommee explicitement (kheops2_dev).
# Local  : mongodb://127.0.0.1:27017/kheops2_dev
# Atlas  : mongodb+srv://UTILISATEUR:MOT_DE_PASSE@CLUSTER.mongodb.net/kheops2_dev?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/kheops2_dev

FRONTEND_URL=http://localhost:3000
PORT=5000

# Mode dev : bypass auth actif (un utilisateur de test est auto-connecte).
# Mettre 'false' pour exiger la connexion reelle (recette en mode strict).
KHEOPS_BYPASS_AUTH=true

# Secrets PROPRES au poste de developpement (jamais ceux de server/.env).
# Generer : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=ICI_METTRE_UNE_CLE_JWT_DE_DEVELOPPEMENT
# Generer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=ICI_METTRE_UNE_CLE_DE_CHIFFREMENT_DE_DEVELOPPEMENT

# Integrations facultatives en local (memes cles que server/.env.example ;
# utiliser des identifiants OAuth de developpement, pas ceux du deploiement).
# GOOGLE_CLIENT_ID=ICI_METTRE_LE_GOOGLE_CLIENT_ID_DE_DEV
# GOOGLE_CLIENT_SECRET=ICI_METTRE_LE_GOOGLE_CLIENT_SECRET_DE_DEV
# GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
# MICROSOFT_CLIENT_ID=ICI_METTRE_LE_CLIENT_ID_AZURE_DE_DEV
# MICROSOFT_AUTHORITY=https://login.microsoftonline.com/common
# MICROSOFT_CALLBACK_URL=http://localhost:5000/api/auth/microsoft/callback
# GMAIL_USER=ICI_METTRE_L_ADRESSE_GMAIL_DE_DEV
# GMAIL_APP_PASSWORD=ICI_METTRE_LE_MOT_DE_PASSE_D_APPLICATION_DE_DEV
